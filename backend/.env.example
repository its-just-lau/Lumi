# Copia este archivo a .env y rellena los valores reales en tu máquina.
# El .env real está ignorado por Git y nunca se sube al repositorio.

# Aplicación
APP_ENV=development
APP_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:8000

# PostgreSQL (Neon). Se configura en la Fase 2.
DATABASE_URL=postgresql+psycopg://USUARIO:CONTRASENA@HOST/BD?sslmode=require

# MongoDB Atlas. Se configura en la Fase 6.
MONGODB_URI=mongodb+srv://USUARIO:CONTRASENA@HOST/?retryWrites=true
MONGODB_DB=lumi

# RabbitMQ (CloudAMQP). Se configura en la Fase 6.
RABBITMQ_URL=amqps://USUARIO:CONTRASENA@HOST/VHOST
WORKER_ENABLED=false

# Autenticación. Se configura en la Fase 3.
JWT_SECRET=CAMBIAR_EN_PRODUCCION
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30

# Google Sign-In: identificador público del cliente Web.
# No es un secreto, pero cada entorno usa el suyo. El valor de desarrollo de la app
# está en local.properties (lumi.googleWebClientId) y no se versiona.
GOOGLE_WEB_CLIENT_ID=TU_CLIENT_ID.apps.googleusercontent.com

# Gemini. Se configura en la Fase 6.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_DAILY_LIMIT_PER_USER=5

# Recordatorios (Fase 7, opcional).
REMINDER_CRON_TOKEN=
FCM_SERVICE_ACCOUNT_JSON_PATH=
